{
  "name": "Dessert Spotter",
  "short_name": "Dessert Spotter",
  "description": "Search the dessert you're craving and find the closest place that has it.",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFF8EE",
